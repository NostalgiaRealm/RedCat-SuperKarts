{
  "name": "redcat-superkarts-recomp",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "redcat-superkarts.desktop",
  "description": "RedCat SuperKarts (2000) with its original race program recompiled from x86 to WebAssembly",
  "author": "NostalgiaRealm",
  "license": "UNLICENSED",
  "engines": { "node": "24.x" },
  "scripts": {
    "recompile": "${RCSK_PYTHON:-python3} -I tools/recomp/build.py",
    "headless": "node tools/run-headless.mjs",
    "manifest": "node tools/build-manifest.mjs",
    "preload": "node tools/build-preload.mjs",
    "assets": "node tools/build-assets.mjs",
    "package": "node tools/package.mjs",
    "package:check": "node tools/package-check.mjs",
    "site:check": "node tools/site-check.mjs",
    "version": "node tools/sync-version.mjs",
    "version:sync": "node tools/sync-version.mjs",
    "desktop": "electron .",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "test:desktop": "node tools/desktop-check.mjs",
    "site:archive": "node tools/site-archive.mjs"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2"
  }
}
